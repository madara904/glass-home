{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glass Home",
  "version": "0.2.0",
  "identifier": "app.glasshome.tool",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5280",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Glass Home",
        "width": 1180,
        "height": 760,
        "minWidth": 1020,
        "minHeight": 660,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Fire TV ohne Werbung, mit Glass Home",
    "copyright": "Glass Home. Uses dumbtv (MIT) and CleanFrame (MIT)."
  }
}
